network.id=$RORKDLT_NETWORK_ID
network.genesis_data=$RORKDLT_GENESIS_DATA
network.genesis_data_file=$RORKDLT_GENESIS_DATA_FILE

node.key.path=$RORKDLT_VALIDATOR_KEY_LOCATION
node.key.create_if_missing=$RORKDLT_NODE_KEY_CREATE_IF_MISSING

network.host_ip=$RORKDLT_HOST_IP_ADDRESS
network.p2p.seed_nodes=$RORKDLT_NETWORK_SEEDS_REMOTE
network.p2p.use_proxy_protocol=$RORKDLT_NETWORK_USE_PROXY_PROTOCOL

state_hash_tree.gc.interval_sec=$RORKDLT_STATE_HASH_TREE_GC_INTERVAL_SEC
state_hash_tree.state_version_history_length=$RORKDLT_STATE_HASH_TREE_STATE_VERSION_HISTORY_LENGTH

db.location=$RORKDLT_DB_LOCATION
db.local_transaction_execution_index.enable=$RORKDLT_DB_LOCAL_TRANSACTION_EXECUTION_INDEX_ENABLE
db.account_change_index.enable=$RORKDLT_DB_ACCOUNT_CHANGE_INDEX_ENABLE
db.entity_listing_indices.enable=$RORKDLT_ENTITY_LISTING_INDICES_ENABLE
db.historical_substate_values.enable=$RORKDLT_DB_HISTORICAL_SUBSTATE_VALUES_ENABLE
db.checkpoints_path=${RORKDLT_DB_CHECKPOINTS_PATH}

mempool.max_transaction_count=${RORKDLT_MEMPOOL_MAX_TRANSACTION_COUNT}
mempool.max_memory=${RORKDLT_MEMPOOL_MAX_MEMORY}
mempool.relayer.interval_ms=${RORKDLT_MEMPOOL_RELAYER_INTERVAL_MS}
mempool.relayer.max_peers=${RORKDLT_MEMPOOL_RELAYER_MAX_PEERS}
mempool.relayer.max_relayed_size=${RORKDLT_MEMPOOL_RELAYER_MAX_RELAYED_SIZE}
mempool.relayer.max_message_transaction_count=${RORKDLT_MEMPOOL_RELAYER_MAX_MESSAGE_TRANSACTION_COUNT}
mempool.relayer.max_message_payload_size=${RORKDLT_MEMPOOL_RELAYER_MAX_MESSAGE_PAYLOAD_SIZE}
mempool.reevaluation.interval_ms=${RORKDLT_MEMPOOL_REEVALUATION_INTERVAL_MS}
mempool.reevaluation.max_count=${RORKDLT_MEMPOOL_REEVALUATION_MAX_COUNT}

protocol.vertex.max_transaction_count=${RORKDLT_PROTOCOL_VERTEX_MAX_TRANSACTION_COUNT}
protocol.vertex.max_total_transactions_size=${RORKDLT_PROTOCOL_VERTEX_MAX_TOTAL_TRANSACTIONS_SIZE}
protocol.vertex.max_total_execution_cost_units_consumed=${RORKDLT_PROTOCOL_VERTEX_MAX_TOTAL_EXECUTION_COST_UNITS_CONSUMED}
protocol.vertex.max_total_finalization_cost_units_consumed=${RORKDLT_PROTOCOL_VERTEX_MAX_TOTAL_FINALIZATION_COST_UNITS_CONSUMED}
protocol.custom_config=${RORKDLT_PROTOCOL_CUSTOM_CONFIG}

api.core.port=$RORKDLT_CORE_API_PORT
api.core.bind_address=$RORKDLT_CORE_API_BIND_ADDRESS
api.core.flags.enable_unbounded_endpoints=${RORKDLT_CORE_API_FLAGS_ENABLE_UNBOUNDED_ENDPOINTS}

api.engine_state.port=$RORKDLT_ENGINE_STATE_API_PORT
api.engine_state.bind_address=$RORKDLT_ENGINE_STATE_API_BIND_ADDRESS

api.mesh.enabled=$RORKDLT_MESH_API_ENABLED
api.mesh.port=$RORKDLT_MESH_API_PORT
api.mesh.bind_address=$RORKDLT_MESH_API_BIND_ADDRESS

api.system.port=$RORKDLT_SYSTEM_API_PORT
api.system.bind_address=$RORKDLT_SYSTEM_API_BIND_ADDRESS
api.system.enable_db_checkpoint=${RORKDLT_SYSTEM_API_ENABLE_DB_CHECKPOINT}

api.prometheus.port=$RORKDLT_PROMETHEUS_API_PORT
api.prometheus.bind_address=$RORKDLT_PROMETHEUS_API_BIND_ADDRESS

testing_forks.enable=$RORKDLT_TESTING_FORKS_ENABLE
testing_forks.fork_config_name=$RORKDLT_TESTING_FORK_CONFIG_NAME

consensus.use_genesis_for_validator_address=$RORKDLT_CONSENSUS_USE_GENESIS_FOR_VALIDATOR_ADDRESS
consensus.validator_address=$RORKDLT_CONSENSUS_VALIDATOR_ADDRESS

bft.vertex_store.max_serialized_size_bytes=$RORKDLT_BFT_VERTEX_STORE_MAX_SERIALIZED_SIZE_BYTES
